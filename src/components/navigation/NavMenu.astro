---
const links = Astro.props.links ?? [
  { href: "/", text: "Home" },
  { href: "/about", text: "About" },
  { href: "/contact", text: "Contact" },
];
---
<nav aria-label="Primary navigation">
  <ul>
    {links.map(link => (
      <li><a href={link.href}>{link.text}</a></li>
    ))}
  </ul>
</nav>
