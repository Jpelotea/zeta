        <span class="brand-mark" aria-hidden="true">Z</span>
        <span class="brand-copy">
          <strong>Zeta</strong>
          <small>Leadership Community</small>
        </span>
      </a>
      <p class="footer-summary">
        A professional financial-services branch and leadership community focused on developing capable professionals, mentors, and future organization builders.
      </p>
    </div>
    
    <div>
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-links">
        <li><a href="/about">About Zeta</a></li>
        <li><a href="/careers">Career Opportunities</a></li>
        <li><a href="/leadership">Leadership Community</a></li>
        <li><a href="/education">Financial Education</a></li>
      </ul>
    </div>
    
    <div>
