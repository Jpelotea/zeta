---
import SectionHeading from './SectionHeading.astro';

const leaders = [
  {
    name: "Shane Villasor Perez",
    title: "Branch Head",
    image: "/images/leader-placeholder-1.svg",
    focus: "Mentorship, leadership development, and organization building."
  },
  {
    name: "Marivien Tan",
    title: "Senior Unit Head",
    image: "/images/leader-placeholder-2.svg",
    focus: "Organization building and developing future leaders."
  },
  {
    name: "Janelyn Pacaonces",
    title: "Unit Head",
    image: "/images/leader-placeholder-3.svg",
    focus: "Client service, coaching, and professional excellence."
  }
];
---

<section class="section section-muted">
  <div class="shell">
    <SectionHeading
      eyebrow="Leadership Community"
      title="Leadership Team"
      text="Meet the professionals guiding Zeta through mentorship, responsible leadership, and continuous development."
      align="center"
    />

    <div class="leader-grid">
      {leaders.map((leader) => (
        <article class="leader-card">
          <img
            src={leader.image}
            alt={`Professional portrait placeholder for ${leader.name}`}
            width="640"
            height="760"
            loading="lazy"
            decoding="async"
          />
          <div class="leader-card-copy">
            <p class="card-kicker">{leader.title}</p>
            <h3>{leader.name}</h3>
            <p>{leader.focus}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
