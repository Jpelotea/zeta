---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/images/zeta-social-preview.png'
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1F6E28" />
    <link rel="icon" type="image/png" href="/images/zeta-favicon.png" />
    <link rel="apple-touch-icon" href="/images/zeta-app-icon.png" />
    <link rel="canonical" href={canonical.href} />
    
    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Zeta" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Zeta — Builder of Builders" />
    
    <!-- Twitter Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage.href} />
    
    <title>{title}</title>
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Zeta',
      description,
      url: canonical.origin,
      logo: new URL('/images/zeta-logo.png', canonical.origin).href,
      slogan: 'Builder of Builders',
      leader: {
        '@type': 'Person',
        name: 'Shane Villasor Perez',
        jobTitle: 'Branch Manager'
      }
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    
    <!-- Client Scripts -->
    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
