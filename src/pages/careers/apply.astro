---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Apply to Zeta" description="Submit an initial recruitment application to explore a professional opportunity with Zeta.">
  <section class="page-hero page-hero-compact">
    <div class="shell narrow">
      <p class="eyebrow eyebrow-light">Recruitment Application</p>
      <h1>Tell Us About Your Professional Direction</h1>
      <p>This initial application helps Zeta understand your background, interests, readiness, and preferred pathway. Submission does not guarantee selection.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell form-layout">
      <aside class="form-aside">
        <h2>Before you begin</h2>
        <ul class="check-list">
          <li>Answer accurately and in your own words.</li>
          <li>Use an email address and mobile number you regularly check.</li>
          <li>Do not submit confidential financial or identity documents at this stage.</li>
          <li>Review the privacy and consent statement before submission.</li>
        </ul>
        <p class="verification-note">Final form fields, privacy language, licensing questions, and internal routing should receive legal, privacy, compliance, and recruitment review.</p>
      </aside>

      <form class="application-form" name="zeta-career-application" method="POST" action="/success" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="zeta-career-application" />
        <p class="visually-hidden">
          <label for="bot-field">Do not fill this out if you are human: </label>
          <input id="bot-field" name="bot-field" />
        </p>

        <fieldset>
          <legend>Basic information</legend>
          <div class="form-grid">
            <label>
              <span>Full name</span>
              <input type="text" name="full-name" autocomplete="name" required />
            </label>
            <label>
              <span>Email address</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label>
              <span>Mobile number</span>
              <input type="tel" name="mobile" autocomplete="tel" required />
            </label>
            <label>
              <span>City or province</span>
              <input type="text" name="location" autocomplete="address-level2" required />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Professional background</legend>
          <div class="form-grid">
            <label>
              <span>Current occupation or role</span>
              <input type="text" name="current-role" required />
            </label>
            <label>
              <span>Years of professional experience</span>
              <select name="experience-years" required>
                <option value="">Select one</option>
                <option value="less-than-1">Less than 1 year</option>
                <option value="1-3">1–3 years</option>
                <option value="4-7">4–7 years</option>
                <option value="8-plus">8 years or more</option>
              </select>
            </label>
          </div>
          <label>
            <span>Relevant experience</span>
            <span class="field-help">Select all that apply.</span>
            <select name="relevant-experience" multiple size="7" required>
              <option value="sales">Sales</option>
              <option value="customer-service">Customer service</option>
              <option value="financial-services">Banking, insurance, or financial services</option>
              <option value="business-development">Business development</option>
              <option value="people-development">Recruitment or people development</option>
              <option value="management">Leadership or management</option>
              <option value="entrepreneurship">Business ownership or entrepreneurship</option>
            </select>
          </label>
        </fieldset>

        <fieldset>
          <legend>Career direction</legend>
          <label>
            <span>Which opportunity are you primarily exploring?</span>
            <select name="pathway" required>
              <option value="">Select one</option>
              <option value="advisor">Financial Advisor development</option>
              <option value="experienced">Experienced-professional opportunity</option>
              <option value="leadership">Leadership and organization building</option>
              <option value="undecided">I need more information before deciding</option>
            </select>
          </label>
          <label>
            <span>Why are you interested in Zeta and financial services?</span>
            <textarea name="motivation" rows="5" required minlength="80"></textarea>
          </label>
          <label>
            <span>What professional capability would you most like to develop in the next 12 months?</span>
            <textarea name="development-goal" rows="4" required></textarea>
          </label>
        </fieldset>

        <fieldset>
          <legend>Readiness and availability</legend>
          <div class="form-grid">
            <label>
              <span>Current licensing status</span>
              <select name="licensing-status" required>
                <option value="">Select one</option>
                <option value="licensed">Currently licensed</option>
                <option value="previously-licensed">Previously licensed</option>
                <option value="processing">Currently processing requirements</option>
                <option value="not-licensed">Not yet licensed</option>
                <option value="need-info">I need more information about licensing</option>
              </select>
            </label>
            <label>
              <span>Preferred level of participation</span>
              <select name="participation" required>
                <option value="">Select one</option>
                <option value="full-time">Full-time professional pathway</option>
                <option value="part-time">Part-time or alongside current work</option>
                <option value="exploring">Still exploring</option>
              </select>
            </label>
            <label>
              <span>Weekly availability for development activities</span>
              <select name="weekly-availability" required>
                <option value="">Select one</option>
                <option value="under-5">Less than 5 hours</option>
                <option value="5-10">5–10 hours</option>
                <option value="11-20">11–20 hours</option>
                <option value="over-20">More than 20 hours</option>
                <option value="variable">Schedule varies and needs discussion</option>
              </select>
            </label>
            <label>
              <span>Earliest possible start date</span>
              <input type="date" name="start-date" placeholder="YYYY-MM-DD" />
            </label>
          </div>
          <label>
            <span>Describe a time you received difficult feedback and how you applied it.</span>
            <textarea name="coachability-example" rows="5" required minlength="80"></textarea>
          </label>
        </fieldset>

        <fieldset>
          <legend>Consent</legend>
          <label class="checkbox-label">
            <input type="checkbox" name="accuracy-confirmed" required /> 
            <span>I confirm that the information I provided is accurate to the best of my knowledge.</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="contact-consent" required /> 
            <span>I consent to being contacted by Zeta regarding this application and related recruitment steps.</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="privacy-consent" required /> 
            <span>I have read and agree to the <a href="/privacy">privacy notice</a>. I understand that submitting this form does not guarantee selection, employment, licensing, compensation, or advancement.</span>
          </label>
        </fieldset>

        <button class="button button-primary" type="submit">Submit Application</button>
      </form>
    </div>
  </section>
</BaseLayout>
