---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const leaders = [
  { name: 'Leadership Profile', title: 'Approved title', focus: 'Mentorship, professional growth, and team development' },
  { name: 'Leadership Profile', title: 'Approved title', focus: 'Client service, coaching, and professional standards' },
  { name: 'Leadership Profile', title: 'Approved title', focus: 'Organization building and future-leader development' }
];

const educationTopics = [
  'Financial Goal Setting',
  'Emergency Fund Preparation',
  'Protection Planning',
  'Retirement Planning',
  'Family Financial Planning',
  'Financial Education for OFWs'
];
---
<BaseLayout
  title="Zeta | Builder of Builders"
  description="Zeta is a professional financial services branch and leadership community dedicated to developing professionals through mentorship, financial education, and leadership development."
>
  <section class="hero">
    <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-light">——Builder of Builders</p>
        <h1>Building Careers. Developing Leaders. Empowering Leaders Who Develop Others.</h1>
        <p class="hero-lead">Zeta is a leadership community in the financial services industry, led by Branch Manager Shane Villasor Perez. We are committed to developing capable professionals through structured learning, mentorship, financial education, and leadership development. Our goal is to help individuals build meaningful careers, strengthen their leadership capabilities, and contribute to a culture where leaders inspire and develop future leaders.</p>
        <div class="button-row">
          <a class="button button-accent" href="/careers">Explore Career Opportunities</a>
          <a class="button button-ghost" href="#discover-zeta">Discover Zeta</a>
        </div>
        <ul class="hero-proof" aria-label="Zeta focus areas">
          <li>Structured Professional Development</li>
          <li>Mentorship from Experienced Leaders</li>
          <li>Leadership Growth Pathways</li>
        </ul>
      </div>
      <div class="hero-visual" aria-label="Portrait and team imagery placeholders">
        <figure class="portrait-card">
          <img src="/images/shane-placeholder.svg" alt="Placeholder for an approved professional portrait of Branch Manager Shane Perez" width="720" height="900" />
          <figcaption>
            <strong>Shane Villasor Perez</strong>
            <span>Branch Manager · Ice Zeta</span>
          </figcaption>
        </figure>
        <div class="hero-statement">
          <span>Builder of Builders</span>
          <strong>Grow. Lead. Build others.</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Zeta positioning">
    <div class="shell trust-grid">
      <p>Professional Excellence</p>
      <p>Purpose-Driven Leadership</p>
      <p>Continuous Learning & Development</p>
      <p>Meaningful Community Impact</p>
    </div>
  </section>

  <section class="section section-introduction" id="discover-zeta">
    <div class="shell split-layout">
      <div>
        <SectionHeading
          eyebrow="About Zeta"
          title="A Leadership Community Built for Growth"
          text="Zeta is more than a community of Financial Advisors—it is a professional organization dedicated to developing capable individuals, cultivating leadership excellence, advancing financial education, and fostering a culture where leaders inspire, mentor, and develop future leaders. Through continuous learning, meaningful collaboration, and a commitment to service, we strive to create lasting value for both our people and the communities they serve."
        />
        <a class="text-link" href="/about">About Zeta <span aria-hidden="true">→</span></a>
      </div>
      <div class="principles-panel">
        <article><span>01</span><h3>Develop capable professionals</h3><p>Build practical confidence, disciplined work habits, and a service-centered professional foundation.</p></article>
        <article><span>02</span><h3>Strengthen leadership</h3><p>Help emerging leaders learn how to mentor, communicate, organize, and guide others responsibly.</p></article>
        <article><span>03</span><h3>Create lasting contribution</h3><p>Use financial education and community involvement to make growth meaningful beyond individual performance.</p></article>
      </div>
    </div>
  </section>

  <section class="section philosophy-section">
    <div class="shell philosophy-grid">
      <div class="philosophy-art" aria-hidden="true">
        <div class="network-ring ring-one"></div>
        <div class="network-ring ring-two"></div>
        <div class="network-node node-center">Z</div>
        <div class="network-node node-a"></div>
        <div class="network-node node-b"></div>
        <div class="network-node node-c"></div>
      </div>
      <div>
        <SectionHeading
          eyebrow="Leadership Philosophy"
          title="Building Leaders Who Build Others"
          text="At Zeta, success is measured not only by individual achievement but by the ability to develop others. Our leadership philosophy is rooted in mentorship, continuous learning, and the belief that strong leaders create opportunities, strengthen teams, and help others reach their potential. By investing in people, we strive to build a culture of sustainable growth, collaboration, and meaningful leadership."
        />
        <blockquote>“Leadership creates its greatest impact when it empowers others to lead.”</blockquote>
        <a class="button button-primary" href="/philosophy">Explore the Philosophy</a>
      </div>
    </div>
  </section>

  <section class="section leadership-feature">
    <div class="shell feature-grid">
      <div class="feature-image-wrap">
        <img src="/images/shane-leadership-placeholder.svg" alt="Placeholder for an approved image representing Shane Perez's professional and leadership journey" width="900" height="760" loading="lazy" />
      </div>
      <div class="feature-copy">
        <SectionHeading
          eyebrow="Leadership"
          title="Led by Shane Villasor Perez"
          text="Shane Villasor Perez leads Zeta with a commitment to developing professionals, fostering a culture of excellence, and building an organization grounded in integrity, mentorship, and long-term impact. Drawing on years of experience in financial services and leadership, she is dedicated to empowering individuals to grow with confidence while contributing to a collaborative and purpose-driven community."
        />
        <ul class="check-list">
          <li>Professional Growth Through Practical Experience</li>
          <li>Mentorship That Develops Capability and Accountability</li>
          <li>Leadership That Creates Opportunities for Others</li>
        </ul>
        <a class="text-link" href="/leadership">Read Shane’s Leadership Journey <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section careers-preview">
    <div class="shell">
      <SectionHeading
        eyebrow="Career Opportunities"
        title="Discover a Career with Purpose and Possibility"
        text="At Zeta, we welcome individuals who are committed to continuous learning, meaningful service, and professional growth. Whether you're beginning your career, making a career transition, or preparing for leadership opportunities, our development pathways are designed to help you build the knowledge, skills, and confidence to move forward. Explore the path that aligns with your aspirations and take the next step in your professional journey."
        align="center"
      />
      <div class="career-cards">
        <article class="career-card career-card-light">
          <p class="card-kicker">Pathway 01</p>
          <h3>Financial Advisor Development</h3>
          <p>Designed for aspiring professionals, career shifters, and experienced client-facing individuals, this pathway provides a structured environment to develop essential skills through comprehensive training, mentorship, practical client engagement, and continuous professional development.</p>
          <ul>
            <li>Professional Orientation & Career Development</li>
            <li>Mentorship & Practical Learning</li>
            <li>Financial Education & Client Service Foundations</li>
          </ul>
          <a class="text-link" href="/careers#financial-advisor">Explore This Path <span aria-hidden="true">→</span></a>
        </article>
        <article class="career-card career-card-dark">
          <p class="card-kicker">Pathway 02</p>
          <h3>Leadership and Organization Building</h3>
          <p>Designed for professionals who aspire to lead beyond individual success, this pathway focuses on developing leadership capabilities, mentoring future professionals, strengthening team performance, and contributing to the long-term growth of the organization. It is an opportunity to create meaningful impact while helping build a culture of excellence and collaboration.</p>
          <ul>
            <li>Leadership Development Opportunities</li>
            <li>Mentorship & Team-Building Experiences</li>
            <li>Contributing to Long-Term Organizational Growth</li>
          </ul>
          <a class="text-link text-link-light" href="/careers#leadership-pathway">Explore This Path <span aria-hidden="true">→</span></a>
        </article>
      </div>
      <div class="centered-actions">
        <a class="button button-primary" href="/careers"> Learn More</a>
        <a class="button button-secondary" href="/careers/apply">Be One of Us</a>
      </div>
    </div>
  </section>

  <section class="section community-section">
    <div class="shell">
      <div class="heading-row">
        <SectionHeading
          eyebrow="Leadership Community"
          title="Meet the People Shaping Zeta’s Future"
          text="Explore how our team members advance their careers through continuous mentorship, performance excellence, and collaborative leadership."
        />
        <a class="text-link" href="/leadership">Meet the Team Guiding Zeta <span aria-hidden="true">→</span></a>
      </div>
      <div class="leader-grid">
        {leaders.map((leader, index) => (
          <article class="leader-card">
            <img src={`/images/leader-placeholder-${index + 1}.svg`} alt="Placeholder for an approved Zeta leadership profile photograph" width="640" height="760" loading="lazy" />
            <div class="leader-card-copy">
              <p class="card-kicker">{leader.title}</p>
              <h3>{leader.name}</h3>
              <p>{leader.focus}</p>
              <a class="text-link" href="/leadership">View Profile <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section achievements-section">
    <div class="shell achievements-grid">
      <div>
        <SectionHeading
          eyebrow="Milestones"
          title="Celebrating Growth, Achievement, and Excellence"
          text="Zeta's milestones showcase our journey of continuous growth, professional excellence, and meaningful impact. From industry recognitions and team promotions to successful events and organizational achievements, each milestone reflects our commitment to developing exceptional professionals and building a stronger future together."
        />
        <a class="button button-primary" href="/achievements">View Events and Achievements</a>
      </div>
      <div class="milestone-collage" aria-label="Achievement image placeholders">
        <img class="milestone-large" src="/images/event-placeholder-1.svg" alt="Placeholder for an approved professional convention or leadership-event photograph" width="780" height="620" loading="lazy" />
        <img src="/images/event-placeholder-2.svg" alt="Placeholder for an approved team milestone photograph" width="480" height="360" loading="lazy" />
        <img src="/images/event-placeholder-3.svg" alt="Placeholder for an approved recognition or professional activity photograph" width="480" height="360" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section stories-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Success Stories"
        title="Real Stories. Meaningful Growth."
        text="Every testimonial highlights a personal journey of growth, shaped by mentorship, professional development, and a supportive community. These authentic experiences demonstrate what's possible through dedication and guidance, while recognizing that every individual's path and results are unique."
        align="center"
      />
      <div class="testimonial-grid">
        <figure class="testimonial-card">
          <blockquote>“With your expertise in leadership and your unwavering support for your team, you have created an environment that fosters creativity, growth, and collaboration. Your dedication as the top branch head in the entire Manulife Philippines has now made me understand the importance of having a leader and has given me a compelling reason to become a Branch Head like you.”</blockquote>
          <figcaption><strong>Partner Yon</strong><span>Branch Unit Head</span></figcaption>
        </figure>
        <figure class="testimonial-card testimonial-featured">
          <blockquote>“I met BH Shane last November 2021... She's so kind, humble, and a good example of a servant leader... Hindi ako nahirapan sa transition from one company to another kasi 100% ang assistance niya. I'm happy and proud na under ako sa branch niya… super inspiring ang success niya from UH-Branch (during the pandemic pa) 💚💚💚. Whatever it takes, I'm your 100% student and follower, BH. May God continue to bless you, as you are a blessing to us...I love you, BH Shane.”</blockquote>
          <figcaption><strong>Faith Franco Orella Ortega</strong><span>Branch Unit Head</span></figcaption>
        </figure>
        <figure class="testimonial-card">
          <blockquote>“BH Shane is a woman with a big heart to share. Her leadership is deeply rooted in helping each of her leaders' families. She has a heart of gold, and anyone under her, including her peers, is very lucky to have her. I'm lucky to have her as a peer and even as a mentor.”</blockquote>
          <figcaption><strong>Jerry P. Acido Jr.</strong><span>Branch Unit Head</span></figcaption>
        </figure>
      </div>
      <div class="centered-actions"><a class="text-link" href="/stories">Read Success Stories <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section education-section">
    <div class="shell education-grid">
      <div>
        <SectionHeading
          eyebrow="Financial Education"
          title="Building Knowledge for Confident Financial Decisions"
          text="At Zeta, we believe financial education is the foundation of informed decision-making. Our educational resources are designed to help individuals understand essential financial concepts, ask more meaningful questions, and build greater confidence in planning for the future. All content is provided for general educational purposes and should not be considered personalized financial advice."
        />
        <a class="button button-secondary" href="/education">Explore Financial Education</a>
      </div>
      <div class="topic-list">
        {educationTopics.map((topic, index) => (
          <a href="/education">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{topic}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="shell final-cta-inner">
      <div>
        <p class="eyebrow eyebrow-light">Your Next Chapter</p>
        <h2>Start Your Journey with Purpose</h2>
        <p>Whether you're exploring a career as a Financial Advisor, preparing for future leadership opportunities, seeking professional mentorship, or simply interested in learning more about Zeta, we'd be glad to connect. Every meaningful journey begins with a conversation—and yours can start today.</p>
      </div>
      <div class="button-row button-row-end">
        <a class="button button-accent" href="/careers/apply">Be One of Us</a>
        <a class="button button-ghost" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
