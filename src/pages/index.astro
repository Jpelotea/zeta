---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const leaders = [
  { name: 'Leadership Profile', title: 'Approved title', focus: 'Mentorship, professional growth, and team development' },
  { name: 'Leadership Profile', title: 'Approved title', focus: 'Client service, coaching, and professional standards' },
  { name: 'Leadership Profile', title: 'Approved title', focus: 'Organization building and future-leader development' }
];

const educationTopics = [
  'Financial goal setting',
  'Emergency-fund preparation',
  'Protection planning',
  'Retirement preparation',
  'Financial planning for families',
  'Financial education for OFWs'
];
---
<BaseLayout
  title="Zeta | Building Careers and Developing Leaders"
  description="Discover Zeta, a professional financial-services branch and leadership community managed by Branch Manager Shane Perez. Explore career, leadership, mentorship, and financial-education opportunities."
>
  <section class="hero">
    <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-light">Zeta Leadership Community</p>
        <h1>Building Careers. Developing Leaders. Creating Leaders Who Build Others.</h1>
        <p class="hero-lead">Zeta is a financial-services leadership community built under the management of Branch Manager Shane Perez. Through mentorship, professional development, financial education, and organization building, Zeta helps aspiring professionals grow into Financial Advisors, leaders, and builders of future leaders.</p>
        <div class="button-row">
          <a class="button button-accent" href="/careers">Explore Career Opportunities</a>
          <a class="button button-ghost" href="#discover-zeta">Discover Zeta</a>
        </div>
        <ul class="hero-proof" aria-label="Zeta focus areas">
          <li>Structured development</li>
          <li>Professional mentorship</li>
          <li>Leadership pathways</li>
        </ul>
      </div>
      <div class="hero-visual" aria-label="Portrait and team imagery placeholders">
        <figure class="portrait-card">
          <img src="/images/shane-placeholder.svg" alt="Placeholder for an approved professional portrait of Branch Manager Shane Perez" width="720" height="900" />
          <figcaption>
            <strong>Shane Villasor Perez</strong>
            <span>Branch Manager · Zeta</span>
          </figcaption>
        </figure>
        <div class="hero-statement">
          <span>Builder of Builders</span>
          <strong>Grow. Lead. Build others.</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Zeta positioning">
    <div class="shell trust-grid">
      <p>Professional standards</p>
      <p>Purposeful leadership</p>
      <p>Continuous development</p>
      <p>Community contribution</p>
    </div>
  </section>

  <section class="section section-introduction" id="discover-zeta">
    <div class="shell split-layout">
      <div>
        <SectionHeading
          eyebrow="About Zeta"
          title="A Leadership Community Built for Growth"
          text="Zeta is more than a group of Financial Advisors. It is a professional organization focused on developing people, strengthening leadership capability, supporting financial education, and building a culture where leaders are prepared to develop other leaders."
        />
        <a class="text-link" href="/about">About Zeta <span aria-hidden="true">→</span></a>
      </div>
      <div class="principles-panel">
        <article><span>01</span><h3>Develop capable professionals</h3><p>Build practical confidence, disciplined work habits, and a service-centered professional foundation.</p></article>
        <article><span>02</span><h3>Strengthen leadership</h3><p>Help emerging leaders learn how to mentor, communicate, organize, and guide others responsibly.</p></article>
        <article><span>03</span><h3>Create lasting contribution</h3><p>Use financial education and community involvement to make growth meaningful beyond individual performance.</p></article>
      </div>
    </div>
  </section>

  <section class="section philosophy-section">
    <div class="shell philosophy-grid">
      <div class="philosophy-art" aria-hidden="true">
        <div class="network-ring ring-one"></div>
        <div class="network-ring ring-two"></div>
        <div class="network-node node-center">Z</div>
        <div class="network-node node-a"></div>
        <div class="network-node node-b"></div>
        <div class="network-node node-c"></div>
      </div>
      <div>
        <SectionHeading
          eyebrow="Leadership Philosophy"
          title="The Builder of Builders Philosophy"
          text="Zeta’s objective is not limited to recruiting individuals or building production. Its broader purpose is to develop professionals who can lead, mentor, build teams, and eventually create opportunities for others."
        />
        <blockquote>“Leadership becomes more valuable when it creates more leaders.”</blockquote>
        <a class="button button-primary" href="/philosophy">Explore the Philosophy</a>
      </div>
    </div>
  </section>

  <section class="section leadership-feature">
    <div class="shell feature-grid">
      <div class="feature-image-wrap">
        <img src="/images/shane-leadership-placeholder.svg" alt="Placeholder for an approved image representing Shane Perez's professional and leadership journey" width="900" height="760" loading="lazy" />
      </div>
      <div class="feature-copy">
        <SectionHeading
          eyebrow="Leadership"
          title="Led by Shane Villasor Perez"
          text="Shane Perez serves as Zeta’s central public-facing branch leader. Her journey from professional development in financial services to branch management provides the foundation for Zeta’s mentorship, standards, and long-term organization-building direction."
        />
        <ul class="check-list">
          <li>Professional growth grounded in practical experience</li>
          <li>Mentorship focused on capability and accountability</li>
          <li>Leadership development designed to multiply opportunity</li>
        </ul>
        <a class="text-link" href="/leadership">Read Shane’s Leadership Journey <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section careers-preview">
    <div class="shell">
      <SectionHeading
        eyebrow="Career Opportunities"
        title="Build a Professional Path With Purpose"
        text="Zeta welcomes people who are ready to learn, serve, grow, and take responsibility for their professional development. Explore the pathway that best reflects where you are today and where you want to go next."
        align="center"
      />
      <div class="career-cards">
        <article class="career-card career-card-light">
          <p class="card-kicker">Pathway 01</p>
          <h3>Financial Advisor Development</h3>
          <p>For aspiring professionals, career shifters, and experienced client-facing people seeking structured training, mentorship, meaningful client work, and performance-based growth.</p>
          <ul>
            <li>Professional orientation and development</li>
            <li>Mentorship and practical learning</li>
            <li>Financial education and client-service foundations</li>
          </ul>
          <a class="text-link" href="/careers#financial-advisor">Explore this pathway <span aria-hidden="true">→</span></a>
        </article>
        <article class="career-card career-card-dark">
          <p class="card-kicker">Pathway 02</p>
          <h3>Leadership and Organization Building</h3>
          <p>For professionals with the ambition and readiness to mentor others, develop teams, strengthen systems, and help build a sustainable leadership community.</p>
          <ul>
            <li>Leadership capability development</li>
            <li>Mentoring and team-building exposure</li>
            <li>Long-term organization-building direction</li>
          </ul>
          <a class="text-link text-link-light" href="/careers#leadership-pathway">Explore this pathway <span aria-hidden="true">→</span></a>
        </article>
      </div>
      <div class="centered-actions">
        <a class="button button-primary" href="/careers">Explore Career Opportunities</a>
        <a class="button button-secondary" href="/careers/apply">Be One of Us</a>
      </div>
    </div>
  </section>

  <section class="section community-section">
    <div class="shell">
      <div class="heading-row">
        <SectionHeading
          eyebrow="Leadership Community"
          title="Meet the People Helping Zeta Grow"
          text="Approved profiles can demonstrate how professionals develop through mentorship, performance, collaboration, and increasing leadership responsibility."
        />
        <a class="text-link" href="/leadership">Meet the Leadership Community <span aria-hidden="true">→</span></a>
      </div>
      <div class="leader-grid">
        {leaders.map((leader, index) => (
          <article class="leader-card">
            <img src={`/images/leader-placeholder-${index + 1}.svg`} alt="Placeholder for an approved Zeta leadership profile photograph" width="640" height="760" loading="lazy" />
            <div class="leader-card-copy">
              <p class="card-kicker">{leader.title}</p>
              <h3>{leader.name}</h3>
              <p>{leader.focus}</p>
              <a class="text-link" href="/leadership">View profile <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section achievements-section">
    <div class="shell achievements-grid">
      <div>
        <SectionHeading
          eyebrow="Milestones"
          title="Achievements That Reflect Professional Growth"
          text="Zeta’s event participation, professional recognition, team promotions, and branch milestones should be presented as a verified record of learning, contribution, and organizational progress."
        />
        <p class="verification-note"><strong>Publication standard:</strong> only verified achievements, approved photographs, and accurately described recognitions will appear on the live website.</p>
        <a class="button button-primary" href="/achievements">View Events and Achievements</a>
      </div>
      <div class="milestone-collage" aria-label="Achievement image placeholders">
        <img class="milestone-large" src="/images/event-placeholder-1.svg" alt="Placeholder for an approved professional convention or leadership-event photograph" width="780" height="620" loading="lazy" />
        <img src="/images/event-placeholder-2.svg" alt="Placeholder for an approved team milestone photograph" width="480" height="360" loading="lazy" />
        <img src="/images/event-placeholder-3.svg" alt="Placeholder for an approved recognition or professional activity photograph" width="480" height="360" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section stories-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Success Stories"
        title="Growth Is Best Understood Through People"
        text="Approved testimonials can show how mentorship, structure, professional standards, and community helped individuals move forward—without promising identical results to every candidate."
        align="center"
      />
      <div class="testimonial-grid">
        <figure class="testimonial-card">
          <blockquote>“Approved testimonial copy will appear here after the contributor confirms the wording and grants permission for publication.”</blockquote>
          <figcaption><strong>Approved contributor</strong><span>Verified role or relationship</span></figcaption>
        </figure>
        <figure class="testimonial-card testimonial-featured">
          <blockquote>“The strongest stories should describe the person’s starting point, the support they received, the work they completed, and the progress they can verify.”</blockquote>
          <figcaption><strong>Editorial standard</strong><span>Zeta success-story framework</span></figcaption>
        </figure>
        <figure class="testimonial-card">
          <blockquote>“Client stories should be published only with clear permission and should never disclose private financial information.”</blockquote>
          <figcaption><strong>Privacy standard</strong><span>Responsible storytelling</span></figcaption>
        </figure>
      </div>
      <div class="centered-actions"><a class="text-link" href="/stories">Read Success Stories <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section education-section">
    <div class="shell education-grid">
      <div>
        <SectionHeading
          eyebrow="Financial Education"
          title="Practical Learning for Better Financial Conversations"
          text="Zeta’s educational content will help people understand foundational financial concepts and prepare more thoughtful questions. The information will remain general and educational rather than personalized financial advice."
        />
        <a class="button button-secondary" href="/education">Explore Financial Education</a>
      </div>
      <div class="topic-list">
        {educationTopics.map((topic, index) => (
          <a href="/education">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{topic}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="shell final-cta-inner">
      <div>
        <p class="eyebrow eyebrow-light">Your next chapter</p>
        <h2>Are You Ready to Build Your Next Chapter?</h2>
        <p>Whether you are exploring a Financial Advisor career, preparing for leadership, seeking professional mentorship, or interested in learning more about Zeta, the next conversation can begin here.</p>
      </div>
      <div class="button-row button-row-end">
        <a class="button button-accent" href="/careers/apply">Be One of Us</a>
        <a class="button button-ghost" href="/contact">Send an Inquiry</a>
      </div>
    </div>
  </section>
</BaseLayout>
