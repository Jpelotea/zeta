---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank You | Zeta" description="Your submission has been received by Zeta.">
  <header class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow eyebrow-light">Submission received</p>
      <h1>Thank You for Reaching Out</h1>
      <p>
        Your details have been successfully transmitted to our team. We appreciate your interest in the Zeta Leadership Community and will review your information carefully.
      </p>
      
      <div class="button-row">
        <a class="button button-accent" href="/">Return Home</a>
        <a class="button button-ghost" href="/careers">Review Career Opportunities</a>
      </div>
    </div>
  </header>
</BaseLayout>
