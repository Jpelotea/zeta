---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Events & Achievements | Zeta"
  description="Explore verified events, professional milestones, leadership development, and organizational achievements within the Zeta Leadership Community."
>

  <!-- Hero -->
  <section class="page-hero">
    <div class="shell narrow">

      <p class="eyebrow eyebrow-light">Events & Achievements</p>

      <h1>Celebrating Growth Through Verified Milestones</h1>

      <p>
        Every milestone represents a commitment to continuous learning,
        professional development, leadership, and meaningful contribution.
        This page highlights approved events, recognitions, and
        organizational achievements that reflect Zeta's journey and the
        growth of its leadership community.
      </p>

    </div>
  </section>

  <!-- Achievement Categories -->
  <section class="section">
    <div class="shell content-grid">

      <article>

        <h2>Professional Events</h2>

        <p>
          Explore participation in leadership conferences, industry
          conventions, professional development programs, and educational
          events that support continuous learning and organizational growth.
        </p>

      </article>

      <article>

        <h2>Leadership & Team Milestones</h2>

        <p>
          Discover verified leadership appointments, promotions,
          organizational milestones, and other significant achievements that
          reflect the continued development of the Zeta Leadership Community.
        </p>

      </article>

      <article>

        <h2>Professional Recognition</h2>

        <p>
          View awards, certifications, and recognized accomplishments that
          are presented accurately and in accordance with their official
          descriptions, recognizing individual and organizational
          contributions without overstating their significance.
        </p>

      </article>

    </div>
  </section>

  <!-- Verification -->
  <section class="section section-muted">
    <div class="shell narrow">

      <h2>Our Commitment to Accuracy</h2>

      <p>
        Every event, milestone, and recognition featured on this page is
        intended to be supported by verifiable information. Published
        entries should include the event or recognition name, date,
        location, participating individuals where appropriate, approved
        photographs or media, and the relevant source of verification.
      </p>

      <p>
        This approach reflects Zeta's commitment to transparency,
        responsible communication, and preserving an accurate record of
        professional and organizational development.
      </p>

      <p class="verification-note">
        Awards, recognitions, and participation records are published only
        after appropriate review and approval. Descriptions are intended to
        reflect official information and should not be interpreted as a
        guarantee of future performance or outcomes.
      </p>

    </div>
  </section>

</BaseLayout>
